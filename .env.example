# Frontend build-time configuration. Copy to .env before building.
#
# Base URL of the Namaz API. Leave empty if the API is served from the same
# origin as the app (e.g. behind /api on the same domain).
#
# On Cloudflare this is your Worker's URL, printed by `wrangler deploy`:
#   VITE_API_BASE_URL=https://namaz-api.YOUR-SUBDOMAIN.workers.dev
# Leaving it empty builds an app with no notifications; everything else works.
VITE_API_BASE_URL=https://api.namaz.example.com

# The city name is looked up in the browser by default, because BigDataCloud's
# free endpoint requires client-side calls. Nothing needs setting for it to work.

# Set to true only if your backend proxies a KEYED geocoding endpoint that
# permits server-side calls. Requires VITE_API_BASE_URL.
VITE_GEOCODE_VIA_BACKEND=

# Set to true to drop the city name entirely and contact no geocoder at all.
# Prayer times, Qibla and Tahajjud are unaffected.
VITE_DISABLE_GEOCODE=
