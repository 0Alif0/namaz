# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=production

# Comma-separated list of origins allowed to call this API.
# Use your real frontend origin, e.g. https://namaz.example.com
ALLOWED_ORIGINS=https://namaz.example.com

# MySQL (created in hPanel > Databases > Management)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_namaz
DB_PASSWORD=
DB_NAME=u123456789_namaz

# Web Push. Generate with: npm run vapid
# The private key must never appear in frontend code.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret the cron job sends as the x-cron-secret header.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Reverse geocoding upstream. OPTIONAL — leave empty unless you have a keyed
# endpoint that permits server-side calls. BigDataCloud's free
# reverse-geocode-client URL must NOT go here: it is client-only, and calling it
# from a server earns a 402 and an IP ban. By default the app geocodes in the
# browser and never calls this route.
GEOCODE_ENDPOINT=
